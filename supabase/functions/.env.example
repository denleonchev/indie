# Sent by scheduled calls in the x-cron-secret header.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Chain to index. Sepolia: 11155111.
CHAIN_ID=11155111

# Needs to keep logs older than the history window.
RPC_URL=https://sepolia.gateway.tenderly.co

# Tokens to index, comma separated. Sepolia USDC by default.
TOKEN_ADDRESSES=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Blocks per eth_getLogs call. Tenderly returns at most 20,000 logs per call.
RANGE_SIZE=2000

# A pass starts no new range after this time. The lease lasts three times longer.
PASS_SOFT_LIMIT_MS=60000

# Keeps a catch-up pass within the 2 s CPU limit of Edge Functions.
MAX_TRANSFERS_PER_PASS=10000
